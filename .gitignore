# Godot 4+ specific ignores
.godot/
/android/

# Local logs, editor backups and Python caches.
*.log
*.blend[0-9]
*.kra~
__pycache__/
*.pyc

# Local credentials and export signing material.
.env
.env.*
!.env.example
export_credentials.cfg
*.p12
*.pfx
*.keystore

# Metadatos de importación de las capturas de revisión (se regeneran al abrir Godot)
production/qa/evidence/**/*.import
docs/previews/*.import

# Exportaciones de compilación
export/
